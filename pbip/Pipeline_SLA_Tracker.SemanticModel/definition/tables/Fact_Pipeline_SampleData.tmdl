	/// Percentage of successful pipeline executions.
	measure 'Success Rate %' = DIVIDE([Successful Runs],[Active Pipelines])
		formatString: 0.00%
		displayFolder: 02 SLA
		lineageTag: 0310c56d-6f43-41ab-9f14-a8d3ce6a960f

		annotation Owner = BI Team

		annotation Category = SLA

		annotation Version = 1.0.0

		annotation DisplayOrder = 10

		annotation Template = Ratio

		annotation Status = Active

		annotation Tags = Executive

		annotation Synonyms = Success Rate

