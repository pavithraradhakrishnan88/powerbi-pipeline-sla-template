	/// Starting position of floating bar timeline.
	measure 'Timeline Base' =
			VAR _Earliest =
			    CALCULATE(
			        MIN(Fact_Pipeline_SampleData[ScheduledStart]),
			        ALL(Fact_Pipeline_SampleData)
			    )
			RETURN
			DATEDIFF(
			    _Earliest,
			    MIN(Fact_Pipeline_SampleData[ScheduledStart]),
			    HOUR
			)
		formatString: dd-MMM HH:mm
		displayFolder: 05 Floating Bar
		lineageTag: f62bacee-85c6-4d48-a4f3-25ec68b67195

		annotation Owner = BI Team

		annotation Category = Floating Bar

		annotation Version = 1.0.0

		annotation DisplayOrder = 10

		annotation Template = Minimum

		annotation Status = Active

		annotation Tags = FloatingBar;Timeline

		annotation Synonyms = Bar Start;Timeline Start

		annotation KPI = False

		annotation DataType = DateTime

		annotation LastUpdated = 2026-08-01

	/// Length of floating bar in hours.
	measure 'Floating Bar Duration' = AVERAGE(Fact_Pipeline_SampleData[DurationHours])
		formatString: #,##0.00
