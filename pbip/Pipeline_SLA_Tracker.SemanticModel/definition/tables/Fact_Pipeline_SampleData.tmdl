table Fact_Pipeline_SampleData
	lineageTag: f8ed2dcd-c402-4584-98ff-818bd06ae87c

	/// Total pipeline executions.
	measure 'Active Pipelines' = COUNTROWS(Fact_Pipeline_SampleData)
		formatString: #,##0
		displayFolder: 01 Landing Page
		lineageTag: 482f78c7-205f-4145-a0ab-a3353b15e990

	/// Percentage of SLA breaches.
	measure 'SLA Breach %' = DIVIDE(CALCULATE(COUNTROWS(Fact_Pipeline_SampleData),Fact_Pipeline_SampleData[SLAStatus]="Missed"),[Active Pipelines])
		formatString: 0.00%
		displayFolder: 02 SLA
		lineageTag: 0b94a07f-d2e1-4a1d-9cd9-ff7118d1fbc8

	/// Starting position of floating bar timeline.
	measure 'Timeline Base' = DATEDIFF(CALCULATE(MIN(Fact_Pipeline_SampleData[ScheduledStart]),ALL(Fact_Pipeline_SampleData)),MIN(Fact_Pipeline_SampleData[ScheduledStart]),HOUR)
		displayFolder: 05 Floating Bar
		lineageTag: f62bacee-85c6-4d48-a4f3-25ec68b67195

	/// Length of floating bar in hours.
	measure 'Floating Bar Duration' = AVERAGE(Fact_Pipeline_SampleData[DurationHours])
		formatString: #,##0.00
		displayFolder: 05 Floating Bar
		lineageTag: a84c2fa1-0e7b-43d7-bf4d-411e871075d5

	/// Status label used for floating bar conditional formatting.
	measure 'Floating Bar Status' = IF(MAX(Fact_Pipeline_SampleData[SLAStatus])="Missed","Breach","Within SLA")
		displayFolder: 05 Floating Bar
		lineageTag: 72a525d2-cada-4ad8-9e25-5bdbeaff725f

	/// Color code for floating bar conditional formatting.
	measure 'SLA Breach Color' = IF(MAX(Fact_Pipeline_SampleData[SLAStatus])="Missed", "#FF0000", "#00B050")
		isHidden
		displayFolder: 05 Floating Bar
		lineageTag: 17b33bc2-853e-4eb8-8a4c-92db87b5242e
