table Fact_Pipeline_SampleData
	lineageTag: f8ed2dcd-c402-4584-98ff-818bd06ae87c

	/// Total pipeline executions.
	measure 'Active Pipelines' = COUNTROWS(Fact_Pipeline_SampleData)
		formatString: #,##0
		displayFolder: 01 Landing Page
		lineageTag: 482f78c7-205f-4145-a0ab-a3353b15e990

		annotation Owner = BI Team

		annotation Category = KPI

		annotation Version = 1.0.0

		annotation DisplayOrder = 10

		annotation Template = CountRows

		annotation Status = Active

		annotation Tags = LandingPage;Executive

		annotation Synonyms = Pipeline Count;Runs

		annotation KPI = True

		annotation DataType = Whole Number

		annotation LastUpdated = 2026-07-31

	/// Successful pipeline executions.
	measure 'Successful Runs' = CALCULATE(COUNTROWS(Fact_Pipeline_SampleData),Fact_Pipeline_SampleData[Status]="Success")
		formatString: #,##0
