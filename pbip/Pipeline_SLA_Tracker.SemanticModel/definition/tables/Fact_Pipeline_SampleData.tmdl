	/// Percentage of SLA breaches.
	measure 'SLA Breach %' = DIVIDE(CALCULATE(COUNTROWS(Fact_Pipeline_SampleData),Fact_Pipeline_SampleData[SLAStatus]="Missed"),[Active Pipelines])
