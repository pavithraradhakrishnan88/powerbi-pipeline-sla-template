		annotation DataType = Percentage

		annotation DependsOn = Successful Runs;Active Pipelines

		annotation LastUpdated = 2026-07-31

	/// Percentage of failed pipeline executions.
	measure 'Failure Rate %' = DIVIDE([Failed Runs],[Active Pipelines])
		formatString: 0.00%
		displayFolder: 02 SLA
		lineageTag: 120eeabd-0511-4077-9563-64edf6233623

