table _Measures

	measure 'Last Refresh' = FORMAT(NOW(),"dd MMM yyyy hh:mm AM/PM")
		displayFolder: '00 System'

	measure 'Active Pipelines' = COUNTROWS(Fact_Pipeline_SampleData)
		displayFolder: '01 Landing Page'
		formatString: '#,##0'

	measure 'Success Rate %' = DIVIDE([Successful Runs],[Active Pipelines])
		displayFolder: '02 SLA'
		formatString: '0.00%'

	measure 'Average Runtime' = AVERAGE(Fact_Pipeline_SampleData[DurationHours])
		displayFolder: '03 Runtime'
		formatString: '0.00'

	measure 'Timeline Base' = DATEDIFF(CALCULATE(MIN(Fact_Pipeline_SampleData[ScheduledStart]), ALL(Fact_Pipeline_SampleData)), MIN(Fact_Pipeline_SampleData[ScheduledStart]), HOUR)
		displayFolder: '05 Floating Bar'
		formatString: '0'

	measure 'Successful Runs' = CALCULATE(COUNTROWS(Fact_Pipeline_SampleData),Fact_Pipeline_SampleData[Status]="Success")
		displayFolder: '01 Landing Page'
		formatString: '#,##0'

	measure 'Failure Rate %' = DIVIDE([Failed Runs],[Active Pipelines])
		displayFolder: '02 SLA'
		formatString: '0.00%'

	measure 'Total Runtime' = SUM(Fact_Pipeline_SampleData[DurationHours])
		displayFolder: '03 Runtime'
		formatString: '#,##0.00'

	measure 'Floating Bar Duration' = [Average Runtime]
		displayFolder: '05 Floating Bar'
		formatString: '#,##0.00'

	measure 'Failed Runs' = CALCULATE(COUNTROWS(Fact_Pipeline_SampleData),Fact_Pipeline_SampleData[Status]="Failed")
		displayFolder: '01 Landing Page'
		formatString: '#,##0'

	measure 'SLA Breach %' = DIVIDE(CALCULATE(COUNTROWS(Fact_Pipeline_SampleData), Fact_Pipeline_SampleData[SLAStatus] = "Missed"), [Active Pipelines], 0)
		displayFolder: '02 SLA'
		formatString: '0.00%'

	measure 'SLA Compliance %' = 1 - [SLA Breach %]
		displayFolder: '02 SLA'
		formatString: '0.00%'

	measure 'Maximum Runtime' = MAX(Fact_Pipeline_SampleData[DurationHours])
		displayFolder: '03 Runtime'
		formatString: '#,##0.00'

	measure 'Floating Bar Status' = IF(MAX(Fact_Pipeline_SampleData[SLAStatus])="Breached","Breach","Within SLA")
		displayFolder: '05 Floating Bar'

	measure 'Running Pipelines' = CALCULATE(COUNTROWS(Fact_Pipeline_SampleData),Fact_Pipeline_SampleData[Status]="Running")
		displayFolder: '01 Landing Page'
		formatString: '#,##0'

	measure 'Minimum Runtime' = MIN(Fact_Pipeline_SampleData[DurationHours])
		displayFolder: '03 Runtime'
		formatString: '#,##0.00'

	measure 'SLA Breach Color' = IF(MAX(Fact_Pipeline_SampleData[SLAStatus])="Breached", "#FF0000", "#00B050")
		displayFolder: '05 Floating Bar'
		isHidden: true

	measure 'Success Rate KPI' = [Success Rate %]
		displayFolder: '02 SLA'
		formatString: '0.00%'

	measure 'Queued Pipelines' = CALCULATE(COUNTROWS(Fact_Pipeline_SampleData),Fact_Pipeline_SampleData[Status]="Queued")
		displayFolder: '01 Landing Page'
		formatString: '#,##0'

	measure 'Average Start Delay' = AVERAGE(Fact_Pipeline_SampleData[StartDelayMinutes])
		displayFolder: '03 Runtime'
		formatString: '#,##0.00'

	measure 'Average End Delay' = AVERAGE(Fact_Pipeline_SampleData[EndDelayMinutes])
		displayFolder: '03 Runtime'
		formatString: '#,##0.00'

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table({}, {})
				in
				    Source
