{
  "name": "Pipeline SLA Tracker Theme",
  "dataColors": [
    "#2E7D32",
    "#C62828",
    "#1565C0",
    "#F9A825",
    "#6A1B9A",
    "#00838F",
    "#EF6C00",
    "#455A64"
  ],
  "good": "#2E7D32",
  "neutral": "#F9A825",
  "bad": "#C62828",
  "background": "#FFFFFF",
  "foreground": "#1C1C1C",
  "tableAccent": "#1565C0",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "color": "#1C1C1C"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#1C1C1C"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#455A64"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labelText": [
          {
            "color": "#1C1C1C",
            "fontSize": 24
          }
        ],
        "categoryLabelText": [
          {
            "color": "#455A64",
            "fontSize": 11
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#1565C0"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "general": [
          {
            "outlineColor": {
              "solid": {
                "color": "#1565C0"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "rowPadding": 6
          }
        ]
      }
    }
  }
}
