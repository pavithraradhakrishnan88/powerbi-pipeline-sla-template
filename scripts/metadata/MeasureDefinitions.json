    {
  "MeasureID": "M016",
  "Name": "Timeline Base",
  "Table": "Fact_Pipeline_SampleData",
  "Folder": "05 Floating Bar",
  "DisplayOrder": 10,
  "Expression": "VAR Earliest =\n    CALCULATE(\n        MIN(Fact_Pipeline_SampleData[ScheduledStart]),\n        ALL(Fact_Pipeline_SampleData)\n    )\nRETURN\nDATEDIFF(\n    Earliest,\n    MIN(Fact_Pipeline_SampleData[ScheduledStart]),\n    HOUR\n)",
  "Format": "#,##0",
  "Description": "Starting position of floating bar timeline.",
  "Category": "Floating Bar",
  "KPI": false,
  "Hidden": false,
  "DataType": "Whole Number",
  "DependsOn": [],
  "Template": "Minimum",
  "Tags": [
    "FloatingBar",
    "Timeline"
  ],
  "Synonyms": [
    "Bar Start",
    "Timeline Start"
  ],
  "Owner": "BI Team",
  "Version": "1.0.0",
  "Status": "Active",
  "LastUpdated": "2026-08-01"
},

