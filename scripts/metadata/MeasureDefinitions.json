      "KPI": true,
      "Hidden": false,
      "DataType": "Percentage",
      "DependsOn": ["Successful Runs", "Active Pipelines"],
      "Template": "Ratio",
      "Tags": ["Executive"],
      "Synonyms": ["Success Rate"],
      "Owner": "BI Team",
      "Version": "1.0.0",
      "Status": "Active",
      "LastUpdated": "2026-07-31"
    },
