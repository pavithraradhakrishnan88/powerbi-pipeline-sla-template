    {
      "MeasureID": "M006",
      "Name": "Success Rate %",
      "Table": "Fact_Pipeline_SampleData",
      "Folder": "02 SLA",
      "DisplayOrder": 10,
      "Expression": "DIVIDE([Successful Runs],[Active Pipelines])",
      "Format": "0.00%",
      "Description": "Percentage of successful pipeline executions.",
