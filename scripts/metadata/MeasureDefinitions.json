      "MeasureID": "M007",
      "Name": "Failure Rate %",
      "Table": "Fact_Pipeline_SampleData",
      "Folder": "02 SLA",
      "DisplayOrder": 20,
      "Expression": "DIVIDE([Failed Runs],[Active Pipelines])",
