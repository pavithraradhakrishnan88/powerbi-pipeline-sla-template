{
  "version": "1.0.0",
  "model": "Pipeline SLA Tracker",
  "measures": [
    {
      "MeasureID": "M001",
      "Name": "Active Pipelines",
      "Table": "Fact_Pipeline_SampleData",
      "Folder": "01 Landing Page",
      "DisplayOrder": 10,
      "Expression": "COUNTROWS(Fact_Pipeline_SampleData)",
      "Format": "#,##0",
      "Description": "Total pipeline executions.",
      "Category": "KPI",
      "KPI": true,
      "Hidden": false,
      "DataType": "Whole Number",
      "DependsOn": [],
      "Template": "CountRows",
      "Tags": ["LandingPage", "Executive"],
      "Synonyms": ["Pipeline Count", "Runs"],
      "Owner": "BI Team",
      "Version": "1.0.0",
      "Status": "Active",
      "LastUpdated": "2026-07-31"
    },
